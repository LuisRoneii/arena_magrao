# Copie este arquivo para ".env" e preencha. O .env NÃO vai para o GitHub.

# conexão com o PostgreSQL: postgres://USUARIO:SENHA@HOST:PORTA/BANCO
# (se a senha tiver caracteres especiais como @ # / :, troque por %40 %23 %2F %3A)
DATABASE_URL=postgres://postgres:SUA_SENHA@localhost:5432/arena_magrao

# banco SÓ para os testes automáticos (npm test). É apagado e recriado a cada
# execução: nunca aponte para o banco de verdade. Crie uma vez com:
#   CREATE DATABASE arena_magrao_teste;
# Sem esta variável, os testes de integração são pulados (os unitários rodam).
DATABASE_URL_TESTE=postgres://postgres:SUA_SENHA@localhost:5432/arena_magrao_teste

# porta da API
PORT=3000

# endereço do site que pode chamar a API (Live Server do VS Code)
CORS_ORIGIN=http://127.0.0.1:5500,http://localhost:5500

# chave que assina o login do painel. Use um texto longo e aleatório (32+ caracteres)
# e NUNCA compartilhe. Para gerar um: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SEGREDO=troque-por-um-texto-longo-e-aleatorio-de-pelo-menos-32-caracteres

# só no servidor (atrás do Nginx): deixa a API enxergar o IP real do visitante,
# necessário para os limites de tentativas. No seu PC, deixe comentado.
# TRUST_PROXY=1
